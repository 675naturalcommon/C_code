# 忽略 Visual Studio 的整个用户特定目录和缓存文件（这是你大文件的来源）
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.slnx

# 忽略编译生成的二进制文件和可执行文件
*.exe
*.out
*.app
*.o
*.obj
*.ilk
*.pdb
*.idb
*.pch
*.ipch # 特别添加，这是你遇到的那些超大的预编译头文件
Debug/
Release/
x64/
x86/
build/
out/
bin/
obj/

# 忽略 VSCode 的本地设置
.vscode/

# 忽略系统文件
.DS_Store
Thumbs.db