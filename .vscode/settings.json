{
  // ============ 原有文件关联配置（保持不变） ============
  "files.associations": {
    "*.json": "cpp",
    "tasks.json": "json",
    "launch.json": "json",
    "c_cpp_properties.json": "json",
    "iostream": "cpp",
    "ostream": "cpp",
    "array": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "cctype": "cpp",
    "charconv": "cpp",
    "chrono": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "compare": "cpp",
    "concepts": "cpp",
    "condition_variable": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "map": "cpp",
    "string": "cpp",
    "unordered_map": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "optional": "cpp",
    "random": "cpp",
    "ratio": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "format": "cpp",
    "initializer_list": "cpp",
    "iomanip": "cpp",
    "iosfwd": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "mutex": "cpp",
    "new": "cpp",
    "numbers": "cpp",
    "ranges": "cpp",
    "semaphore": "cpp",
    "shared_mutex": "cpp",
    "span": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "stop_token": "cpp",
    "streambuf": "cpp",
    "text_encoding": "cpp",
    "thread": "cpp",
    "typeinfo": "cpp",
    "variant": "cpp",
    "stdio.h": "c",
    "stdlib.h": "c",
    "string.h": "c",
    "time.h": "c"
  },
  "C_Cpp.errorSquiggles": "disabled",
  "github.copilot.nextEditSuggestions.enabled": false,

  // ============ C/C++ 扩展配置 ============
  // 为 C++ 文件单独指定默认格式化程序
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // 如果你也希望 C 文件使用它，可以一并配置
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // 确保保存时格式化是开启的
  "editor.formatOnSave": true

  // ============ Code Runner 配置（保持不变） ============
  "code-runner.executorMap": {
    "c": "cd $dir && D:\\msys\\ucrt64\\bin\\gcc.exe -fdiagnostics-color=always -g $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe",
    "cpp": "cd $dir && D:\\msys\\ucrt64\\bin\\g++.exe -fdiagnostics-color=always -g $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe",
    "python": "python -u",
    "java": "cd $dir && javac $fileName && java $fileNameWithoutExt",
    "javascript": "node"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.ignoreSelection": false,
  "code-runner.preserveFocus": false,
  "code-runner.showExecutionMessage": true,
  "code-runner.respectShebang": false,
  "code-runner.executorMapByFileExtension": {
    ".vb": "cd $dir && vbc /nologo $fileName && $dir$fileNameWithoutExt"
  },

  // ============ C/C++ 扩展基本配置（保持不变） ============
  "C_Cpp.default.compilerPath": "D:\\msys\\ucrt64\\bin\\gcc.exe",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**"
  ],

  // ============ 新增 Memory View 扩展配置 ============
  "memoryView.general.defaultEndianness": "little",
  "memoryView.general.defaultViewType": "hex",
  "memoryView.general.showAsciiColumn": true,
  "memoryView.general.bytesPerLine": 16,
  "memoryView.general.highlightChangedBytes": true,

  "memoryView.debuggerIntegration.enabled": true,
  "memoryView.debuggerIntegration.autoOpen": true,
  "memoryView.debugger.type": "gdb",
  "memoryView.gdb.path": "D:\\msys\\ucrt64\\bin\\gdb.exe",
  "memoryView.gdb.autoConnect": true,

  "memoryView.format.uppercaseHex": true,
  "memoryView.format.groupBytes": 4,
  "memoryView.format.showOffsets": true,
  "memoryView.addressRadix": "hex",

  "memoryView.memoryRegions.autoAddStack": true,
  "memoryView.memoryRegions.autoAddHeap": false,
  "memoryView.memoryRegions.stackSize": 512,

  "memoryView.advanced.autoRefreshInterval": 1000,
  "memoryView.advanced.maxMemoryReadSize": 65536,
  "memoryView.advanced.enableCaching": true,

  // 颜色主题（可根据个人喜好调整）
  "memoryView.theme.highlightColor": "#ff555555",
  "memoryView.theme.changedByteColor": "#55ff5555",
  "memoryView.theme.addressColor": "#5555ffff",

  // ============ 新增调试优化配置 ============
  "debug.toolBarLocation": "floating",
  "debug.inlineValues": true,
  "debug.onTaskErrors": "showErrors",
  "debug.openDebug": "openOnDebugStart",
  "debug.openExplorerOnEnd": false,
  "debug.allowBreakpointsEverywhere": true,
  "debug.showVariableTypes": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.console.collapseIdenticalLines": true,
  "debug.console.fontSize": 14,
  "debug.console.wordWrap": true,
  "debug.focusWindowOnBreak": true,
  "debug.showSubSessionsInToolBar": true,

  // C/C++ 调试专用
  "C_Cpp.debugger.useBacktickCommandParsing": false,
  "C_Cpp.debugger.showDisplayString": true

  // ============ 可选：终端环境变量（如需使用 Node.js 可取消注释） ============
  // 如果还需要运行 Mocha 测试，可以取消下面注释，并根据实际 Node.js 安装路径调整
  // "terminal.integrated.env.windows": {
  //     "PATH": "${env:PATH};D:\\000_Node.js"
  // }
}
